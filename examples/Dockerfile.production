# Production Dockerfile for the Malevolent Gods Astro site
#
# This builds the site as static output and serves it with nginx.
# It is intended to sit behind a separate edge nginx reverse proxy
# on the shared Docker network `ai-backend`.

FROM node:24.22.1-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.31.8 AS runtime
WORKDIR /usr/share/nginx/html

RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist/ /usr/share/nginx/html/
# Public assets can retain restrictive permissions from the build host.
RUN chmod -R a+rX /usr/share/nginx/html
COPY examples/nginx.site-container.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
