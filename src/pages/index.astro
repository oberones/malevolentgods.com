---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import MusicCard from '@/components/MusicCard.astro';
import ArtistCard from '@/components/ArtistCard.astro';
import HomeFeatureList from '@/components/HomeFeatureList.astro';
import { getGlobalSiteData } from '@/lib/content';
import { getHomepageContent } from '@/lib/home-content';

const { settings, fallbackSite } = await getGlobalSiteData();
const hero = settings?.homepageHero || fallbackSite.homepageHero;
const { featuredArtists, featuredMusic, spotlightRelease } = await getHomepageContent();

const homeFeatures = [
  {
    title: 'Unlicensed frequencies',
    body: 'Albums, singles, remixes, and DJ sets from the collective’s various identities.'
  },
  {
    title: 'Unstable images',
    body: 'Generative, digital, hand-drawn, and machine-assisted work.'
  },
  {
    title: 'Working experiments',
    body: 'Games, tools, and systems released before anyone could stop us.'
  }
];
---

<BaseLayout title="Home">
  <section class="relative overflow-hidden border-b border-white/5 py-20 sm:py-28">
    <Container class="grid items-start gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="mb-4 text-sm uppercase tracking-[0.35em] text-accentAlt">{hero.eyebrow}</p>
        <h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-text sm:text-6xl lg:text-7xl">
          {hero.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-textMuted sm:text-xl">
          {hero.summary}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          {hero.primaryCtaLabel && hero.primaryCtaHref && (
            <Button href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</Button>
          )}
          {hero.secondaryCtaLabel && hero.secondaryCtaHref && (
            <Button href={hero.secondaryCtaHref} variant="secondary">{hero.secondaryCtaLabel}</Button>
          )}
        </div>
      </div>

      <Card class="min-h-[320px] bg-gradient-to-br from-surface via-surfaceAlt to-bg">
        <div class="flex h-full flex-col justify-between gap-8">
          <div>
            <p class="text-sm uppercase tracking-[0.3em] text-accentAlt">Current spotlight</p>
            {spotlightRelease ? (
              <>
                <h2 class="mt-4 text-2xl font-semibold text-text">{spotlightRelease.title}</h2>
                <p class="mt-4 text-base leading-7 text-textMuted">{spotlightRelease.summary}</p>
                <div class="mt-6">
                  <a href={spotlightRelease.href} class="inline-flex text-sm font-medium text-accentAlt transition hover:text-text">
                    Open release page →
                  </a>
                </div>
              </>
            ) : (
              <>
                <h2 class="mt-4 text-2xl font-semibold text-text">The signal is temporarily quiet</h2>
                <p class="mt-4 text-base leading-7 text-textMuted">
                  Something new will occupy this space as soon as it escapes containment.
                </p>
              </>
            )}
          </div>
          <HomeFeatureList items={homeFeatures} />
        </div>
      </Card>
    </Container>
  </section>

  <Section
    title="Featured artists"
    intro="Meet the aliases behind the noise."
  >
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {featuredArtists.map((artist) => (
        <ArtistCard
          name={artist.name}
          shortBio={artist.shortBio}
          href={artist.href}
          links={artist.links}
        />
      ))}
    </div>
  </Section>

  <Section
    title="Featured music"
    intro="A few useful entry points into the signal."
    class="pt-0"
  >
    <div class="grid gap-6 lg:grid-cols-3">
      {featuredMusic.map((item) => (
        <MusicCard
          title={item.title}
          summary={item.summary}
          href={item.href}
          embed={item.embed}
        />
      ))}
    </div>
  </Section>

  <Section
    title="Other disturbances"
    intro="The music is only one branch of the problem."
    class="pt-0"
  >
    <div class="grid gap-6 lg:grid-cols-3">
      <Card>
        <h3 class="text-xl font-semibold text-text">
          <a href="/art" class="transition hover:text-accentAlt">Art →</a>
        </h3>
        <p class="mt-3 text-sm leading-6 text-textMuted">
          Generative, digital, hand-drawn, and machine-assisted images from across the collective.
        </p>
      </Card>
      <Card>
        <h3 class="text-xl font-semibold text-text">
          <a href="/writing" class="transition hover:text-accentAlt">Writing →</a>
        </h3>
        <p class="mt-3 text-sm leading-6 text-textMuted">
          Essays, field notes, fiction, and fragments that survived being written down.
        </p>
      </Card>
      <Card>
        <h3 class="text-xl font-semibold text-text">
          <a href="/projects" class="transition hover:text-accentAlt">Projects</a>
          <span class="text-textMuted"> and </span>
          <a href="/apps" class="transition hover:text-accentAlt">apps →</a>
        </h3>
        <p class="mt-3 text-sm leading-6 text-textMuted">
          Playable experiments, creative tools, autonomous systems, and other software with questionable supervision.
        </p>
      </Card>
    </div>
  </Section>
</BaseLayout>
