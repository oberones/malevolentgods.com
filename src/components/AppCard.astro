---
import Card from '@/components/Card.astro';

export interface Props {
  title: string;
  summary: string;
  appType: string;
  href: string;
}

const { title, summary, appType, href } = Astro.props;
---

<Card class="flex h-full flex-col justify-between gap-6">
  <div>
    <p class="text-xs uppercase tracking-[0.28em] text-accentAlt">{appType}</p>
    <h3 class="mt-3 text-2xl font-semibold text-text">{title}</h3>
    <p class="mt-4 text-sm leading-6 text-textMuted">{summary}</p>
  </div>

  <a
    href={href}
    aria-label={`Open ${title}`}
    class="inline-flex self-start text-sm font-medium text-accentAlt transition hover:text-text"
  >
    Open app →
  </a>
</Card>
